{
  "info": {
    "name": "Code Review API",
    "description": "Postman collection for testing the AI Code Review Assistant API locally and on Render.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ai-code-review-assistant-dhz3.onrender.com",
      "type": "string"
    },
    {
      "key": "localBaseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "renderBaseUrl",
      "value": "https://ai-code-review-assistant-dhz3.onrender.com",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "language",
      "value": "Java",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create code review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"Java\",\n  \"code\": \"public class Main { public static void main(String[] args) { System.out.println(\\\"Hello World\\\"); } }\",\n  \"prompt\": \"Review this code for readability, structure, bugs, edge cases, and possible improvements.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reviews"
          ]
        },
        "description": "Creates a new AI-powered code review. Uses the OpenAI API through the deployed Spring Boot backend."
      }
    },
    {
      "name": "Get all reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reviews"
          ]
        },
        "description": "Returns all stored code reviews from PostgreSQL."
      }
    },
    {
      "name": "Get review by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reviews/{{reviewId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reviews",
            "{{reviewId}}"
          ]
        },
        "description": "Returns a single code review by ID. Update the reviewId collection variable if needed."
      }
    },
    {
      "name": "Filter reviews by language",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reviews/language/{{language}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reviews",
            "language",
            "{{language}}"
          ]
        },
        "description": "Returns reviews filtered by programming language. Update the language collection variable if needed."
      }
    },
    {
      "name": "Delete review by ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reviews/{{reviewId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reviews",
            "{{reviewId}}"
          ]
        },
        "description": "Deletes a single review by ID. Update the reviewId collection variable before sending."
      }
    },
    {
      "name": "Delete all reviews",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reviews"
          ]
        },
        "description": "Deletes all stored reviews. Use carefully."
      }
    }
  ]
}